{
  "name": "nitori-scale",
  "version": "0.1.0",
  "description": "Read Torrey scales (and similar ones) from the browser with Web Serial: polling, a parser for ST/US flags and units, a stabilizer tuned on real scales, reconnection and a simulator. No dependencies.",
  "type": "module",
  "main": "./dist/nitori.umd.js",
  "module": "./dist/nitori.mjs",
  "browser": "./dist/nitori.umd.js",
  "exports": {
    ".": {
      "import": "./dist/nitori.mjs",
      "require": "./dist/nitori.umd.js",
      "default": "./dist/nitori.mjs"
    }
  },
  "files": ["dist", "src", "README.md", "LICENSE"],
  "scripts": {
    "build": "python scripts/build.py",
    "test": "node --test test/"
  },
  "keywords": ["web-serial", "scale", "torrey", "pos", "weight", "labels"],
  "author": "chidaruma696",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/Chidaruma696/Nitori.git" },
  "homepage": "https://github.com/Chidaruma696/Nitori#readme",
  "bugs": { "url": "https://github.com/Chidaruma696/Nitori/issues" },
  "engines": { "node": ">=20" }
}
